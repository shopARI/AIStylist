# ARI Fashion AI System - Environment Configuration
# Generated to match config/settings.py structure

# === ENVIRONMENT ===
ENVIRONMENT=production  # development, staging, production, testing
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# === DATABASES (REQUIRED) ===
# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_QUERY_TIMEOUT=30.0
MAX_QUERY_TIMEOUT=60.0
BATCH_SIZE=100
ENABLE_CONNECTION_POOLING=true

# Qdrant (optional - leave URL empty for local)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=fashion_products
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_GRPC=true
QDRANT_TIMEOUT=30.0
QDRANT_ENABLE_POOLING=true

# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_DECODE_RESPONSES=true

# === AI SERVICES (REQUIRED) ===
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_REQUEST_TIMEOUT=60

# === CAMEL AI CONFIGURATION ===
CAMEL_VERSION_REQUIRED=0.2.7
CAMEL_MODEL_TYPE=gpt-4o-mini
CAMEL_MODEL_PLATFORM=openai
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4000
MEMORY_TOKEN_LIMIT=2048
ENABLE_VECTOR_MEMORY=true
ENABLE_CHAT_HISTORY=true

# === BATTLE SYSTEM ===
ENABLE_CACHE=true
ENABLE_OPTIMIZATION=true
ENABLE_METRICS=true
BATTLE_CACHE_TTL=300
BATTLE_CACHE_MAX_SIZE=1000
CACHE_STRATEGY=lru  # lru, lfu, fifo
CACHE_CLEANUP_INTERVAL=60
MAX_CONCURRENT_BATTLES=5
BATTLE_TIMEOUT=120.0
PREFETCH_MULTIPLIER=2
QUALITY_THRESHOLD=0.5
ENABLE_AUTO_RECOVERY=true
RECOVERY_ATTEMPTS=3
RECOVERY_INTERVAL=60

# === CONNECTION MANAGEMENT ===
CONNECTION_RETRY_DELAY=5
CONNECTION_MAX_RETRIES=3
CONNECTION_HEALTH_CHECK_INTERVAL=60
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300
CONNECTION_POOL_SIZE=10

# === MEMORY OPTIMIZATION ===
MEMORY_OPTIMIZATION_INTERVAL=3600
MAX_MEMORY_RECORDS=1000
MEMORY_CLEANUP_THRESHOLD=0.8
ENABLE_MEMORY_OPTIMIZATION=true

# === SECURITY ===
ENABLE_PII_PROTECTION=true
MAX_IMAGE_SIZE=10485760  # 10MB
MAX_IMAGE_DIMENSION=4096
MIN_IMAGE_DIMENSION=32
IMAGE_REQUEST_TIMEOUT=10
MAX_IMAGE_REDIRECTS=2
ALLOWED_IMAGE_DOMAINS=  # Comma-separated additional domains

# === FEATURE FLAGS ===
ENABLE_LUXURY_MODE=true
ENABLE_WARDROBE_TRACKING=true
VIP_CLIENT_FEATURES=true
ENABLE_ML_INTELLIGENCE=true
ENABLE_BEHAVIORAL_ANALYSIS=true
ENABLE_VISUAL_INTELLIGENCE=true
ENABLE_SEMANTIC_SEARCH=true

# === PERFORMANCE ===
BATCH_PROCESSING_SIZE=4
GPU_MEMORY_THRESHOLD=0.8
CPU_THREAD_POOL_SIZE=4
ASYNC_IO_POOL_SIZE=10