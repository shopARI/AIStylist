        # The Flow already runs in parallel, so a single run demonstrates parallel performance
        assert True # Placeholder for actual test

    @pytest.mark.skipif(not (NEO4J_AVAILABLE and QDRANT_AVAILABLE and OPENAI_AVAILABLE),
        reason="Required services not available")
    @pytest.mark.asyncio
    async def test_timeout_enforcement_real_database(self):
        """Test that timeouts work with real database queries."""
        from tools.async_tools.async_neo4j_tools import async_neo4j_query_tool

        # Test with reasonable timeout
        start = time.time()

        try:
        result = await asyncio.wait_for(
        async_neo4j_query_tool.func(
        cypher="MATCH (p:Product) RETURN p LIMIT 10",
        parameters={}
        ),
        timeout=30.0
        )
        elapsed = time.time() - start

        print(f"\n Query completed in {elapsed:.2f}s (within 30s timeout)")
        assert elapsed < 30

        except asyncio.TimeoutError:
        elapsed = time.time() - start
        print(f"\n Query timed out after {elapsed:.2f}s")
        assert abs(elapsed - 30.0) < 1.0 # Should timeout at ~30s


class TestOutputValidation:
    """Validate Pydantic output structure with real data."""

    @pytest.mark.skipif(not (NEO4J_AVAILABLE and QDRANT_AVAILABLE and OPENAI_AVAILABLE),
    reason="Required services not available")
    @pytest.mark.asyncio
    async def test_pydantic_product_validation(self):
        """Test that real products validate against Pydantic model."""
        from crews.mini_crews import (
        create_graph_search_crew,
        create_vector_search_crew,
        create_visual_search_crew,
        create_judge_crew
        )

        result = await create_and_run_flow(
        query="dress",
        limit=3,
        graph_crew=create_graph_search_crew(),
        vector_crew=create_vector_search_crew(),
        visual_crew=create_visual_search_crew(),
        judge_crew=create_judge_crew()
        )

        # Validate ProductSearchResult structure
        assert isinstance(result, ProductSearchResult)
        assert hasattr(result, 'products')
        assert hasattr(result, 'graph_count')
        assert hasattr(result, 'vector_count')
        assert hasattr(result, 'visual_count')
        assert hasattr(result, 'execution_time')

        # Validate individual products
        for product in result.products:
        assert isinstance(product, Product)
        assert hasattr(product, 'id')
        assert hasattr(product, 'title')
        assert hasattr(product, 'price')
        assert hasattr(product, 'category')
        assert product.price > 0 # Pydantic validation

        print(f"\n All {len(result.products)} products validated against Pydantic schema")


        if __name__ == "__main__":
        pytest.main([__file__, "-v", "-s"])
