class TestCompleteFlowExecution:
    """Test complete Flow execution with real databases."""

    @pytest.mark.skipif(not (NEO4J_AVAILABLE and QDRANT_AVAILABLE and OPENAI_AVAILABLE),
    reason="Required services not available")
    @pytest.mark.asyncio
    async def test_complete_product_search_flow(self):
        """Test complete ProductSearchFlow with real databases."""
        from crews.mini_crews import (
        create_graph_search_crew,
        create_vector_search_crew,
        create_visual_search_crew,
        create_judge_crew
        )

        print("\n" + "="*70)
        print("COMPLETE FLOW EXECUTION TEST")
        print("="*70)

        # Create mini-crews
        graph_crew = create_graph_search_crew()
        vector_crew = create_vector_search_crew()
        visual_crew = create_visual_search_crew()
        judge_crew = create_judge_crew()

        # Test query
        test_query = "elegant black dress for wedding"
        print(f"\nQuery: '{test_query}'")

        # Measure execution time
        start_time = time.time()

        # Run complete flow
        result = await create_and_run_flow(
        query=test_query,
        limit=5,
        graph_crew=graph_crew,
        vector_crew=vector_crew,
        visual_crew=visual_crew,
        judge_crew=judge_crew
        )

        execution_time = time.time() - start_time

        # Validate result
        assert isinstance(result, ProductSearchResult)
        assert result.products is not None
        assert isinstance(result.products, list)

        # Print results
        print(f"\n{'='*70}")
        print("RESULTS")
        print(f"{'='*70}")
        print(f"Total Products Found: {len(result.products)}")
        print(f"Graph Search Products: {result.graph_count}")
        print(f"Vector Search Products: {result.vector_count}")
        print(f"Visual Search Products: {result.visual_count}")
        print(f"Total Execution Time: {execution_time:.2f}s")
        print(f"Flow Reported Time: {result.execution_time:.2f}s")
        print(f"{'='*70}")

        # Print sample products
        if len(result.products) > 0:
        print("\nSample Products:")
        for i, product in enumerate(result.products[:3], 1):
        print(f"\n{i}. {product.title}")
        print(f" ID: {product.id}")
        print(f" Price: ${product.price:.2f}")
        print(f" Category: {product.category}")

        # Validate performance
        assert execution_time < 120, f"Flow took too long: {execution_time:.2f}s"

        # Expected: 3-7s with real queries, but may be slower on first run
        if execution_time < 10:
        print(f"\n Performance excellent: {execution_time:.2f}s")
        elif execution_time < 30:
        print(f"\n Performance good: {execution_time:.2f}s")
        else:
        print(f"\n Performance slower than expected: {execution_time:.2f}s")

    @pytest.mark.skipif(not (NEO4J_AVAILABLE and QDRANT_AVAILABLE and OPENAI_AVAILABLE),
        reason="Required services not available")
    @pytest.mark.asyncio
    async def test_flow_with_filters(self):
        """Test Flow with category filters."""
        from crews.mini_crews import (
        create_graph_search_crew,
        create_vector_search_crew,
        create_visual_search_crew,
        create_judge_crew
        )

        result = await create_and_run_flow(
        query="summer dress",
        limit=5,
        filters={"category": "dress"},
        graph_crew=create_graph_search_crew(),
        vector_crew=create_vector_search_crew(),
        visual_crew=create_visual_search_crew(),
        judge_crew=create_judge_crew()
        )

        assert isinstance(result, ProductSearchResult)
        print(f"\n Flow with filters returned {len(result.products)} products")

    @pytest.mark.skipif(not (NEO4J_AVAILABLE and QDRANT_AVAILABLE and OPENAI_AVAILABLE),
        reason="Required services not available")
    @pytest.mark.asyncio
    async def test_multiple_queries(self):
        """Test multiple queries to measure consistency."""
        from crews.mini_crews import (
        create_graph_search_crew,
        create_vector_search_crew,
        create_visual_search_crew,
        create_judge_crew
        )

        test_queries = [
        "black dress",
        "casual shoes",
        "winter jacket"
        ]

        results = {}

        for query in test_queries:
        start = time.time()

        result = await create_and_run_flow(
        query=query,
        limit=5,
        graph_crew=create_graph_search_crew(),
        vector_crew=create_vector_search_crew(),
        visual_crew=create_visual_search_crew(),
        judge_crew=create_judge_crew()
        )

        elapsed = time.time() - start
        results[query] = {
        'products': len(result.products),
        'time': elapsed
        }

        # Print summary
        print(f"\n{'='*70}")
        print("MULTIPLE QUERY TEST RESULTS")
        print(f"{'='*70}")
        for query, data in results.items():
        print(f"{query:30} {data['products']:>3} products in {data['time']:>6.2f}s")
        print(f"{'='*70}")

        avg_time = sum(r['time'] for r in results.values()) / len(results)
        print(f"\nAverage execution time: {avg_time:.2f}s")

        assert all(r['time'] < 120 for r in results.values()), "Some queries too slow"


