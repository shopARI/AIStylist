"""
Phase 5 End-to-End Tests: Real Database Integration
Tests complete Flow execution with real Neo4j, Qdrant, and FashionSigLIP.
"""
import pytest
import asyncio
import os
import time
from typing import Dict, List

from flows.product_search_flow import create_and_run_flow
from models.product_models import ProductSearchResult, Product


# Check for required environment variables
NEO4J_AVAILABLE = all([
 os.getenv('NEO4J_URI'),
 os.getenv('NEO4J_USER'),
 os.getenv('NEO4J_PASSWORD')
])

QDRANT_AVAILABLE = all([
 os.getenv('QDRANT_URL'),
 os.getenv('QDRANT_API_KEY')
])

OPENAI_AVAILABLE = os.getenv('OPENAI_API_KEY') is not None

FASHIONSIG_AVAILABLE = os.path.exists('/models/fashionsig_model') # Example path


class TestNeo4jIntegration:
    """Test Neo4j graph database integration."""

    @pytest.mark.skipif(not NEO4J_AVAILABLE, reason="Neo4j credentials not available")
    @pytest.mark.asyncio
    async def test_neo4j_connection(self):
        """Test basic Neo4j connection."""
        from tools.async_tools.async_neo4j_tools import async_neo4j_query_tool

        # Test simple query
        result = await async_neo4j_query_tool.func(
        cypher="MATCH (p:Product) RETURN count(p) as total LIMIT 1",
        parameters={}
        )

        assert result is not None
        assert len(result) > 0
        print(f"\n Neo4j connection successful. Total products: {result[0].get('total', 0)}")

    @pytest.mark.skipif(not NEO4J_AVAILABLE, reason="Neo4j credentials not available")
    @pytest.mark.asyncio
    async def test_neo4j_product_search(self):
        """Test Neo4j product search."""
        from tools.async_tools.async_neo4j_tools import async_neo4j_query_tool

        # Search for dress products
        cypher = """
        MATCH (p:Product)
        WHERE toLower(p.title) CONTAINS 'dress'
        RETURN p.id as id, p.title as title, p.price as price, p.category as category
        LIMIT 5
        """

        result = await async_neo4j_query_tool.func(cypher=cypher, parameters={})

        assert result is not None
        assert len(result) > 0
        print(f"\n Found {len(result)} dress products in Neo4j")

        # Validate product structure
        for product in result:
        assert 'id' in product
        assert 'title' in product
        assert 'price' in product

    @pytest.mark.skipif(not NEO4J_AVAILABLE, reason="Neo4j credentials not available")
    @pytest.mark.asyncio
    async def test_semantic_expansion(self):
        """Test semantic query expansion."""
        from tools.async_tools.async_neo4j_tools import async_semantic_expansion_tool

        result = await async_semantic_expansion_tool.func(
        query="elegant wedding dress",
        context={"occasion": "wedding"}
        )

        assert result is not None
        assert 'original' in result
        assert result['original'] == "elegant wedding dress"
        assert 'synonyms' in result
        assert 'expanded_query' in result
        print(f"\n Semantic expansion: {len(result['synonyms'])} synonyms found")


class TestQdrantIntegration:
    """Test Qdrant vector database integration."""

    @pytest.mark.skipif(not (QDRANT_AVAILABLE and OPENAI_AVAILABLE), reason="Qdrant/OpenAI not available")
    @pytest.mark.asyncio
    async def test_qdrant_connection(self):
        """Test basic Qdrant connection."""
        from qdrant_client import AsyncQdrantClient

        client = AsyncQdrantClient(
        url=os.getenv('QDRANT_URL'),
        api_key=os.getenv('QDRANT_API_KEY')
        )

        try:
        collections = await client.get_collections()
        assert collections is not None
        print(f"\n Qdrant connection successful. Collections: {len(collections.collections)}")
        finally:
        await client.close()

    @pytest.mark.skipif(not (QDRANT_AVAILABLE and OPENAI_AVAILABLE), reason="Qdrant/OpenAI not available")
    @pytest.mark.asyncio
    async def test_embedding_generation(self):
        """Test OpenAI embedding generation."""
        from tools.async_tools.async_qdrant_tools import async_embedding_generation_tool

        embedding = await async_embedding_generation_tool.func(
        text="red evening dress",
        model="text-embedding-3-small"
        )

        assert embedding is not None
        assert len(embedding) > 0
        print(f"\n Embedding generated: {len(embedding)} dimensions")

    @pytest.mark.skipif(not (QDRANT_AVAILABLE and OPENAI_AVAILABLE), reason="Qdrant/OpenAI not available")
    @pytest.mark.asyncio
    async def test_qdrant_vector_search(self):
        """Test Qdrant vector similarity search."""
        from tools.async_tools.async_qdrant_tools import async_qdrant_hybrid_search_tool

        results = await async_qdrant_hybrid_search_tool.func(
        query_text="elegant black dress",
        limit=5,
        filters=None,
        collection_name="fashion_products"
        )

        assert results is not None
        print(f"\n Qdrant search returned {len(results)} products")

        # Validate result structure
        if len(results) > 0:
        product = results[0]
        assert 'id' in product
        assert 'score' in product


