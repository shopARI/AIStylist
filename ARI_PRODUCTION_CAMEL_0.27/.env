# Production Environment Configuration
# Neo4j Graph Database - productionbackup2
NEO4J_URL=neo4j://34.135.40.119:7687
NEO4J_URI=neo4j://34.135.40.119:7687
NEO4J_USERNAME=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=shopari1234
NEO4J_DATABASE=productionbackup2
NEO4J_QUERY_TIMEOUT=120.0
NEO4J_CONNECTION_TIMEOUT=20

# Qdrant Vector Database - Fashion Products Collection
QDRANT_URL=https://9ac8ffa1-c5b7-47e2-a832-3ce559f42042.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.zz1R7TKuAT4A0dX-M-oZbgX9sYT-x6bwT1EMPGKZ6Jg
QDRANT_COLLECTION_NAME=fashion_products
QDRANT_TIMEOUT=90.0

# Qdrant Visual Embeddings Collection (for VisionBot)
QDRANT_VISUAL_COLLECTION_NAME=fashion_multimodal_embeddings
FASHIONSIG_MODEL_NAME=Marqo/marqo-fashionSigLIP
VISUAL_EMBEDDING_BATCH_SIZE=32
VISUAL_FUSION_STRATEGY=concatenate

# OpenAI API Configuration
OPENAI_API_KEY=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
OPENAI_REQUEST_TIMEOUT=120

# Model Configuration - Using GPT-5 (latest available)
OPENAI_MODEL=gpt-5
CAMEL_MODEL_TYPE=gpt-5

# Redis Configuration (local fallback)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Configuration
NUM_WORKER_THREADS=4
API_PORT=5000
CAMEL_VERSION=0.2.7
MEMORY_TOKEN_LIMIT=1024
ENABLE_MCP=true

# Performance Tuning for Large Graph (6.4M+ nodes)
NEO4J_MAX_POOL_SIZE=100
BATTLE_TIMEOUT=150.0
MAX_QUERY_TIMEOUT=180.0

