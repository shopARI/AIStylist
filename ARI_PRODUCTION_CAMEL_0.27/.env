# SECURITY WARNING: REPLACE ALL VALUES WITH YOUR ACTUAL CREDENTIALS
# THE OLD CREDENTIALS IN THIS FILE HAVE BEEN COMPROMISED AND MUST BE ROTATED

# Neo4j Connection Settings
NEO4J_URL=bolt://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEW_SECURE_PASSWORD

# Increase timeouts
QDRANT_TIMEOUT=60.0
OPENAI_REQUEST_TIMEOUT=60
NEO4J_QUERY_TIMEOUT=60.0
BATTLE_TIMEOUT=60.0

# OpenAI API Key - MUST BE ROTATED IMMEDIATELY
OPENAI_API_KEY=REPLACE_WITH_NEW_OPENAI_KEY

# Qdrant Configuration (remote) - MUST BE ROTATED IMMEDIATELY  
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=REPLACE_WITH_NEW_QDRANT_KEY
QDRANT_COLLECTION_NAME=fashion_products

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60
REQUIRE_API_KEY=false

# Service Configuration
NUM_WORKER_THREADS=4
API_PORT=8000

CAMEL_VERSION=0.2.7
MEMORY_TOKEN_LIMIT=1024
ENABLE_MCP=true

